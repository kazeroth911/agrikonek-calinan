rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(profilePath(request.auth.uid))
        && (get(profilePath(request.auth.uid)).data.roles.get('admin', false) == true);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- profiles ------------------------------------------------------
    // Read: any signed-in user (marketplace needs names/barangays).
    // Create/full update: admin only (researcher-led profiling).
    // Owners may update only their own non-privileged fields.
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['roles', 'createdAt', 'consentUrl']));
    }

    // ---- listings ------------------------------------------------------
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---- offers (bids) -------------------------------------------------
    // Visible only to buyer, listing owner, and admin.
    match /offers/{offerId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);
    }

    // ---- barter proposals ----------------------------------------------
    match /barterProposals/{barterId} {
      allow read: if isSignedIn()
        && (resource.data.proposerId == request.auth.uid
            || resource.data.ownerId == request.auth.uid
            || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.proposerId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.proposerId == request.auth.uid
            || resource.data.ownerId == request.auth.uid);
    }

    // ---- conversations & messages --------------------------------------
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(conversationId))
               .data.participantIds;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn(); // readBy updates
      }
    }

    // ---- notifications --------------------------------------------------
    // The app writes one record per negotiation move; the Cloud Function
    // sendPushOnNotification then sends the FCM push (DFD process 6.0).
    // A user may only notify the other party of a bid, barter or chat
    // they are actually part of, so nobody can spam arbitrary accounts.
    function docData(path) {
      return get(path).data;
    }

    function isPair(a, b, x, y) {
      return (a == x && b == y) || (a == y && b == x);
    }

    function validNotificationShape(d) {
      return d.keys().hasOnly(['recipientId', 'senderId', 'type', 'payload', 'read', 'createdAt'])
        && d.keys().hasAll(['recipientId', 'senderId', 'type', 'payload', 'read', 'createdAt'])
        && d.senderId == request.auth.uid
        && d.recipientId is string
        && d.recipientId != request.auth.uid
        && d.type in ['bid', 'barter', 'msg', 'admin']
        && d.payload is map
        && d.read == false
        && d.createdAt == request.time;
    }

    function senderIsParty(d) {
      return (d.type == 'bid'
          && isPair(d.senderId, d.recipientId,
               docData(/databases/$(database)/documents/offers/$(d.payload.offerId)).buyerId,
               docData(/databases/$(database)/documents/offers/$(d.payload.offerId)).sellerId))
        || (d.type == 'barter'
          && isPair(d.senderId, d.recipientId,
               docData(/databases/$(database)/documents/barterProposals/$(d.payload.barterId)).proposerId,
               docData(/databases/$(database)/documents/barterProposals/$(d.payload.barterId)).ownerId))
        || (d.type == 'msg'
          && d.senderId in docData(/databases/$(database)/documents/conversations/$(d.payload.conversationId)).participantIds
          && d.recipientId in docData(/databases/$(database)/documents/conversations/$(d.payload.conversationId)).participantIds)
        || (d.type == 'admin' && isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
      // Only the recipient can change read from false to true.
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create: if isSignedIn()
        && validNotificationShape(request.resource.data)
        && senderIsParty(request.resource.data);
      allow delete: if false;
    }

    // ---- private FCM device tokens -------------------------------------
    // Each signed-in user can manage only their own device registrations.
    match /deviceTokens/{userId}/tokens/{tokenId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'token', 'platform', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'token', 'platform', 'updatedAt'
        ])
        && request.resource.data.token is string
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isOwner(userId);
    }
  }
}
