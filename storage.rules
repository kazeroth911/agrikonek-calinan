rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos are public-readable to signed-in users (marketplace feed),
    // writable only into the uploader's own folder, capped at 2 MB
    // (uploads are already client-resized to ~1280px / q75).
    match /listings/{ownerUid}/{photo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /profiles/{uid}/{photo} {
      allow read: if request.auth != null;
      // Researcher-admin uploads farm photos during profiling, so any
      // signed-in writer is acceptable here; per-role tightening can
      // follow once custom claims or an admin allowlist exists.
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
