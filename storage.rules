rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Researcher-admins are recognized from their Firestore profile, the
    // same way firestore.rules does it. (The first deploy asks to let
    // Storage read Firestore; answer yes.)
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid))
             .data.roles.get('admin', false) == true;
    }

    function isSmallImage() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Listing photos: readable by signed-in users (marketplace feed),
    // writable only into the uploader's own folder, capped at 2 MB
    // (uploads are already client-resized to ~1280px / q75).
    match /listings/{ownerUid}/{photo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && isSmallImage();
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Farm and consent photos taken during researcher profiling: only
    // researcher-admins may upload or remove them.
    match /profiles/{uid}/{photo} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && isSmallImage();
      allow delete: if isAdmin();
    }
  }
}
